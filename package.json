{
  "name": "heima-jizhang",
  "productName": "记账App",
  "version": "0.1.0",
  "description": "记账App - 记录每一笔花销的个人记账桌面软件",
  "main": "out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "typecheck": "tsc --noEmit -p tsconfig.json && vue-tsc --noEmit -p src/renderer/tsconfig.web.json",
    "smoke": "esbuild src/main/db.ts --bundle --platform=node --format=esm --outfile=scripts/.tmp/db.mjs && node scripts/smoke-test.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^37.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.1.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vue-tsc": "^2.2.0"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "dayjs": "^1.11.13",
    "echarts": "^6.1.0",
    "element-plus": "^2.9.7",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "xlsx": "^0.18.5"
  },
  "allowScripts": {
    "electron@37.10.3": true,
    "esbuild@0.25.12": true,
    "electron-winstaller@5.4.0": true
  }
}
