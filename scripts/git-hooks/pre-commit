#!/bin/sh
# ============================================================================
# git 提交前钩子（pre-commit）
# ----------------------------------------------------------------------------
# 大白话：这是 git 每次要"存档"之前，自动先跑的一段小脚本。
#        它只做一件事——把活儿交给 Node 脚本去判断，通过就放行，不通过就拦下。
# 安装方式：在项目目录运行 `npm run gate:setup`（只需一次）。
# 注意：本文件必须保持 LF 换行（见 .gitattributes），否则 Windows 下会报
#      "bad interpreter"（解释器找不到）而无法执行。
# ============================================================================

# Windows 上如果没装 Node，直接拦住并说人话，避免报一堆看不懂的错误
if ! command -v node >/dev/null 2>&1; then
  echo "✗ 找不到 node，无法检查提交质量。请先安装 Node.js（在终端输入 node -v 应能显示版本号）。"
  exit 1
fi

# exec：把当前进程直接替换成 Node 脚本，省一层开销
exec node "$(git rev-parse --show-toplevel)/scripts/quality-gate.cjs" check
